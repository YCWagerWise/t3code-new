{
  "$defs": {
    "AnswerPayload": {
      "properties": {
        "request_id": {
          "type": "string"
        },
        "value": {
          "default": null
        }
      },
      "required": ["request_id"],
      "type": "object"
    },
    "ApprovalPayload": {
      "properties": {
        "args": {
          "default": null
        },
        "reason": {
          "default": null,
          "type": ["string", "null"]
        },
        "request_id": {
          "type": "string"
        },
        "request_type": {
          "default": null,
          "type": ["string", "null"]
        },
        "tool": {
          "default": null,
          "type": ["string", "null"]
        }
      },
      "required": ["request_id"],
      "type": "object"
    },
    "ApprovePayload": {
      "properties": {
        "approved": {
          "type": "boolean"
        },
        "request_id": {
          "type": "string"
        }
      },
      "required": ["request_id", "approved"],
      "type": "object"
    },
    "AttemptIdentity": {
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "attempt_number": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "resume_of_attempt_id": {
          "default": null,
          "type": ["string", "null"]
        },
        "resumed_from_checkpoint_id": {
          "default": null,
          "type": ["string", "null"]
        },
        "retry_of_run_id": {
          "default": null,
          "type": ["string", "null"]
        }
      },
      "required": ["attempt_id", "attempt_number"],
      "type": "object"
    },
    "CheckpointObservation": {
      "properties": {
        "artifact_ref": {
          "type": "string"
        },
        "body_id": {
          "type": "string"
        },
        "body_version": {
          "type": "string"
        },
        "checkpoint_id": {
          "type": "string"
        },
        "model_id": {
          "type": "string"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "side_effects_after_checkpoint_unknown": {
          "default": false,
          "type": "boolean"
        },
        "usage": {
          "$ref": "#/$defs/ExecutionUsage"
        }
      },
      "required": [
        "checkpoint_id",
        "artifact_ref",
        "body_id",
        "body_version",
        "model_id",
        "protocol_version",
        "usage"
      ],
      "type": "object"
    },
    "ChildRunSnapshot": {
      "properties": {
        "attempt": {
          "$ref": "#/$defs/AttemptIdentity"
        },
        "child_run_id": {
          "type": "string"
        },
        "deadline_at_ms": {
          "default": null,
          "format": "int64",
          "type": ["integer", "null"]
        },
        "event_head": {
          "$ref": "#/$defs/EventCursor"
        },
        "last_heartbeat_at_ms": {
          "default": null,
          "format": "int64",
          "type": ["integer", "null"]
        },
        "last_progress_at_ms": {
          "default": null,
          "format": "int64",
          "type": ["integer", "null"]
        },
        "last_progress_marker": {
          "default": null,
          "type": ["string", "null"]
        },
        "lease_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "limits": {
          "$ref": "#/$defs/ExecutionLimits"
        },
        "parent_run_id": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "resumable_checkpoint_id": {
          "default": null,
          "type": ["string", "null"]
        },
        "settlement_policy": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/RunState"
        },
        "state_version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalOutcome"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "usage": {
          "$ref": "#/$defs/ExecutionUsage"
        }
      },
      "required": [
        "child_run_id",
        "parent_run_id",
        "required",
        "settlement_policy",
        "attempt",
        "state",
        "state_version",
        "lease_generation",
        "event_head",
        "limits",
        "usage"
      ],
      "type": "object"
    },
    "ClientHello": {
      "description": "The first application frame a client sends after transport upgrade.\n\nA WebSocket being open is not authentication and is not readiness.",
      "properties": {
        "fleet_id": {
          "type": "string"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "replay": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ReplayRequest"
          },
          "type": "array"
        },
        "requested_scopes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "session_binding": {
          "type": "string"
        },
        "subscriptions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Subscription"
          },
          "type": "array"
        }
      },
      "required": ["protocol_version", "fleet_id", "session_binding"],
      "type": "object"
    },
    "CmdPayload": {
      "properties": {
        "attachments": {
          "default": [],
          "items": true,
          "type": "array"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["text"],
      "type": "object"
    },
    "CommandEnvelope": {
      "properties": {
        "actor": {
          "type": "string"
        },
        "command": {
          "$ref": "#/$defs/RunCommand"
        },
        "expected_lease_generation": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "fleet_id": {
          "type": "string"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "request_id": {
          "description": "Caller-generated stable idempotency key.",
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "fleet_id",
        "thread_id",
        "run_id",
        "request_id",
        "actor",
        "command"
      ],
      "title": "CommandEnvelope",
      "type": "object"
    },
    "CtxPayload": {
      "description": "Context pressure. Both in tokens.",
      "properties": {
        "used": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "window": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["used", "window"],
      "type": "object"
    },
    "DenyPayload": {
      "properties": {
        "args": {
          "default": null
        },
        "call_id": {
          "default": null,
          "type": ["string", "null"]
        },
        "reason": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": ["tool", "reason"],
      "type": "object"
    },
    "DiffFile": {
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "default": null,
          "description": "`A` added · `M` modified · `D` deleted · `R` renamed · `T` type-changed.",
          "type": ["string", "null"]
        }
      },
      "required": ["path"],
      "type": "object"
    },
    "DiffPayload": {
      "description": "What the turn did to the filesystem, derived from a git checkpoint at the turn boundary\nrather than from tool calls — so it reports an edit made by `sed` inside `run_bash`, or\nby a CLI body's own shell that the tool Registry never sees.",
      "properties": {
        "checkpoint": {
          "default": null,
          "description": "The checkpoint's `seq`, not its commit hash — a monotonic number within the\nworkspace's checkpoint stack, which is what `/_vcs/restore` addresses.",
          "format": "int64",
          "type": ["integer", "null"]
        },
        "files": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DiffFile"
          },
          "type": "array"
        },
        "unified": {
          "default": null,
          "type": ["string", "null"]
        }
      },
      "type": "object"
    },
    "EdgePayload": {
      "description": "A fleet delegation edge — one run handing work to another, possibly on another node.\n\nThere is deliberately no `from`: the edge is published on the *caller's* feed via\n`publish_current`, so the origin is the feed it arrives on. Sending it would be a second,\nforgeable copy of a fact the envelope already carries.",
      "properties": {
        "detail": {
          "default": null
        },
        "edge": {
          "default": null,
          "description": "`delegate` when the caller waited, `delegate_async` when it did not.",
          "type": ["string", "null"]
        },
        "ms": {
          "default": null,
          "format": "int64",
          "type": ["integer", "null"]
        },
        "run_id": {
          "default": null,
          "type": ["string", "null"]
        },
        "state": {
          "default": null,
          "type": ["string", "null"]
        },
        "task": {
          "default": null,
          "type": ["string", "null"]
        },
        "to": {
          "default": null,
          "type": ["string", "null"]
        }
      },
      "type": "object"
    },
    "ErrorClass": {
      "oneOf": [
        {
          "const": "provider",
          "description": "The body ran and failed — a failed drive, a tool that errored.",
          "type": "string"
        },
        {
          "const": "transport",
          "description": "The connection or the node itself.",
          "type": "string"
        },
        {
          "const": "permission",
          "description": "Refused: bad credentials, or a run this caller may not address.",
          "type": "string"
        },
        {
          "const": "validation",
          "description": "The caller sent something malformed, or not allowed from its role.",
          "type": "string"
        }
      ]
    },
    "EventCursor": {
      "properties": {
        "epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": ["epoch", "seq"],
      "type": "object"
    },
    "EventEnvelope": {
      "properties": {
        "cursor": {
          "$ref": "#/$defs/EventCursor"
        },
        "fleet_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "payload": true,
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "recorded_at_ms": {
          "format": "int64",
          "type": "integer"
        },
        "run_id": {
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "fleet_id",
        "run_id",
        "cursor",
        "recorded_at_ms",
        "kind",
        "payload"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "ExecutionLimits": {
      "properties": {
        "max_tokens": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "max_tool_calls": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "max_turn_requests": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "max_wall_time_ms": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "session_budget_id": {
          "default": null,
          "type": ["string", "null"]
        }
      },
      "type": "object"
    },
    "ExecutionUsage": {
      "properties": {
        "tokens": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "tool_calls": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "turn_requests": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "wall_time_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "FeedFrame": {
      "description": "One durable row off a run's feed.\n\n# Handling this exhaustively\n\nA consumer wants two different behaviours that look identical if you are careless:\n\n- a kind it does not *know* (this build predates it) → ignore, silently, forever\n- a kind it knows but has not *handled* → a bug, and one a compiler can catch\n\nDecode first, then match. An unknown kind fails decoding and never reaches the match;\na known-but-unhandled kind is a non-exhaustive match. A single catch-all arm over a raw\nstring — which is what the lens does today — collapses both into silence.",
      "oneOf": [
        {
          "description": "Legacy turn boundary. Four states, and an unrecognised one has historically rendered\nas success — hence [`TurnState`] being closed rather than a string.",
          "properties": {
            "kind": {
              "const": "turn",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/TurnPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "description": "The supervisor's authoritative run state. Companion to [`FeedBody::Turn`], not a\nreplacement: this carries all ten [`RunState`]s, `Turn` publishes four.",
          "properties": {
            "kind": {
              "const": "lifecycle",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/LifecyclePayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "user",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/TextPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "assistant",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/TextPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "thinking",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/TextPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "tool_call",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/ToolCallPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "tool_result",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/ToolResultPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "deny",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/DenyPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "approval",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/ApprovalPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "question",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/QuestionPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "description": "Non-fatal; the turn continues past it. Distinct from a transport `error`, which is\nterminal — a warning must never render as a failed turn.",
          "properties": {
            "kind": {
              "const": "warning",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/WarningPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "ctx",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/CtxPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "usage",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/UsagePayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "edge",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/EdgePayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "diff",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/DiffPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "cmd",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/CmdPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "interrupt",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/InterruptPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "approve",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/ApprovePayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "answer",
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/AnswerPayload"
            }
          },
          "required": ["kind", "payload"],
          "type": "object"
        }
      ],
      "properties": {
        "epoch": {
          "description": "Identifies the feed incarnation. `seq` restarts at zero when the isolate is\nrecreated, so a `seq` is only meaningful paired with the epoch it was issued under.",
          "format": "int64",
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "run_id": {
          "type": "string"
        },
        "seq": {
          "format": "int64",
          "type": "integer"
        },
        "ts": {
          "format": "int64",
          "type": "integer"
        },
        "version": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": ["version", "epoch", "seq", "ts", "run_id", "role"],
      "title": "FeedFrame",
      "type": "object"
    },
    "HandshakeFrame": {
      "oneOf": [
        {
          "properties": {
            "payload": {
              "$ref": "#/$defs/ClientHello"
            },
            "type": {
              "const": "client_hello",
              "type": "string"
            }
          },
          "required": ["type", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "payload": {
              "$ref": "#/$defs/ServerReady"
            },
            "type": {
              "const": "server_ready",
              "type": "string"
            }
          },
          "required": ["type", "payload"],
          "type": "object"
        },
        {
          "properties": {
            "payload": {
              "$ref": "#/$defs/StructuredError"
            },
            "type": {
              "const": "connection_rejected",
              "type": "string"
            }
          },
          "required": ["type", "payload"],
          "type": "object"
        }
      ],
      "title": "HandshakeFrame"
    },
    "InterruptPayload": {
      "properties": {
        "reason": {
          "default": null,
          "type": ["string", "null"]
        }
      },
      "type": "object"
    },
    "LifecyclePayload": {
      "properties": {
        "attempt_id": {
          "default": null,
          "type": ["string", "null"]
        },
        "attempt_number": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "run_id": {
          "default": null,
          "type": ["string", "null"]
        },
        "snapshot_version": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "state": {
          "$ref": "#/$defs/RunState"
        },
        "terminal": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecycleTerminal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "thread_id": {
          "default": null,
          "type": ["string", "null"]
        }
      },
      "required": ["state"],
      "type": "object"
    },
    "LifecycleTerminal": {
      "properties": {
        "detail": {
          "default": null
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["reason"],
      "type": "object"
    },
    "LimitReason": {
      "enum": [
        "max_turn_requests",
        "max_tokens",
        "session_budget_exceeded",
        "max_tool_calls",
        "max_wall_time"
      ],
      "type": "string"
    },
    "ObservationEnvelope": {
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "event_id": {
          "description": "Stable idempotency key assigned by the worker/harness.",
          "type": "string"
        },
        "fleet_id": {
          "type": "string"
        },
        "lease_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "observation": {
          "$ref": "#/$defs/WorkerObservation"
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "provider_seq": {
          "description": "Strictly increases within one attempt plus lease generation.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "run_id": {
          "type": "string"
        },
        "thread_id": {
          "type": "string"
        }
      },
      "required": [
